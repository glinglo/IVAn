# Telegram: token de @BotFather y tu ID numérico (pídeselo a @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Cadena aleatoria larga; Telegram la manda en cada petición al webhook
TELEGRAM_WEBHOOK_SECRET=

# Supabase: Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Vercel lo manda en las llamadas del cron (Authorization: Bearer ...)
CRON_SECRET=

# OpenAI: solo para transcribir notas de voz
OPENAI_API_KEY=

# Cadena aleatoria larga para firmar los enlaces al panel
PANEL_SECRET=

# URL pública de la app (Vercel)
APP_URL=https://ivan-xxx.vercel.app
